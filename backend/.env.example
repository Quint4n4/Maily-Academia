# Copia este archivo como .env y rellena los valores.
# NUNCA subas .env a git.

# --- Django ---
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos ---
# En local con docker-compose, DB_HOST lo sobreescribe el propio compose a "db".
DB_NAME=maily_academia
DB_USER=postgres
DB_PASSWORD=cambia-esto
DB_HOST=localhost
DB_PORT=5432

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Cloudinary (imagenes) ---
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# --- Email ---
# En desarrollo conviene: django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.tu-proveedor.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@ejemplo.com
FRONTEND_URL=http://localhost:5173

# --- Monitoreo de errores (opcional) ---
# Sin esta variable la aplicacion arranca igual y no se envia nada.
# El DSN se saca de sentry.io -> tu proyecto -> Settings -> Client Keys.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- Stripe (modo test) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=mxn
